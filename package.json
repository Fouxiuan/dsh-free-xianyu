{
  "name": "dsh-free-xianyu",
  "version": "1.1.0",
  "type": "module",
  "description": "Free Xianyu monitor for DeepSeek Harness: ships the ai-goofish-monitor sources, provisions its own Python runtime, and adds goofish_* agent tools, a sidebar panel and the full Vue console, with AI analysis served by dsh-our-free-model free lanes.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "xianyu",
    "goofish",
    "second-hand",
    "ai-analysis"
  ],
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "upstream",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs/screenshots",
    "assets",
    "screenshots.json",
    "dsh-free-xianyu-architecture.html"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fouxiuan/dsh-free-xianyu.git"
  },
  "homepage": "https://github.com/Fouxiuan/dsh-free-xianyu#readme",
  "bugs": {
    "url": "https://github.com/Fouxiuan/dsh-free-xianyu/issues"
  },
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "node scripts/prepublish-check.mjs",
    "selftest": "node client.selftest.mjs && node lib/runtime.selftest.mjs && node lib/frontend.selftest.mjs && node lib/gateway.selftest.mjs && node lib/goofish-api.selftest.mjs"
  }
}
